{
    // Terminal > Run Task... (or Ctrl+Shift+P > "Tasks: Run Task").
    // These start the backend AND the client with one command, like node dev.js does from a terminal.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start app",
            "type": "shell",
            "command": "node dev.js",
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        },
        {
            "label": "Start app (with demo data)",
            "type": "shell",
            "command": "node dev.js --demo",
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        }
    ]
}
